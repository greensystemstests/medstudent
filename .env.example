# ---------------------------------------------------------------------------
# Payments API (server/index.js). Set these in your host's environment
# settings (e.g. Render → Environment). Never commit real values.
# ---------------------------------------------------------------------------

# Stripe secret key (sk_test_... / sk_live_..., or a restricted rk_... key
# with PaymentIntents read+write). Server-only: never put it in frontend code.
STRIPE_SECRET_KEY=""

# Stripe publishable key (pk_test_... / pk_live_...). Must be the same mode
# (test/live) as the secret key. Served to the browser by /api/config.
STRIPE_PUBLISHABLE_KEY=""

# Signing secret of the Stripe webhook endpoint pointing at
# https://<api-host>/api/stripe/webhook (whsec_...). Optional but recommended.
STRIPE_WEBHOOK_SECRET=""

# Comma-separated browser origins allowed to call the API.
# Default: https://studybg.ac, https://www.studybg.ac, the GitHub Pages URL and localhost:3000.
# ALLOWED_ORIGINS="https://studybg.ac,https://www.studybg.ac"

# ---------------------------------------------------------------------------
# Invoicing & receipt emails (server/invoice.js, server/mail.js, server/kv.js).
# All of these must be set for invoices/emails to go out; if any is missing,
# payments still work, invoicing is just skipped (and logged as skipped).
# ---------------------------------------------------------------------------

# Render Key Value (Redis-compatible) connection string. Used only to assign
# gap-free sequential invoice numbers and to make sure each payment is only
# ever invoiced/emailed once, even if Stripe redelivers its webhook.
REDIS_URL=""

# Resend API key (https://resend.com) for sending the receipt + sale-alert emails.
RESEND_API_KEY=""

# "From" address for both emails. The domain must be verified in Resend
# (Resend → Domains → add studybg.ac → add the DNS records it gives you).
INVOICE_FROM_EMAIL="StudyBg Billing <billing@studybg.ac>"

# Your own inbox: gets one email per successful payment ("New sale: ...").
SALE_NOTIFICATION_EMAIL=""

# Seller details required on every Bulgarian invoice. All four are mandatory —
# invoicing is skipped (payments still work) until they're all set.
COMPANY_LEGAL_NAME=""
COMPANY_EIK=""             # ЕИК / Bulstat (UIC) number
COMPANY_ADDRESS=""
COMPANY_CITY=""
# Leave empty if not VAT-registered (invoice then shows the ЗДДС Art. 113(9)
# exemption note instead of a VAT breakdown). Set to charge/show 20% VAT.
COMPANY_VAT_NUMBER=""

# First invoice number to issue (only used the very first time; ignored after
# the counter exists in Redis). Set this above 1 if you already issued manual
# invoices you need to continue numbering from.
INVOICE_START_NUMBER="1"

# ---------------------------------------------------------------------------
# Frontend build (Vite). Public base URL of the payments API, no trailing slash.
# Leave empty in local dev (Vite proxies /api to localhost:8787).
# ---------------------------------------------------------------------------
VITE_API_BASE_URL=""
